{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFJiff",
  "version": "0.1.0",
  "identifier": "com.pdfjiff.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDFJiff",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Fast, private PDF tools",
    "longDescription": "Inspect, compress and merge PDFs locally without uploading documents.",
    "copyright": "Copyright PDFJiff contributors"
  }
}
